{
  "name": "filenest",
  "version": "1.3.0",
  "private": true,
  "description": "Apple-style self-hosted web file manager with server-side archive extraction, copy and move (no bandwidth waste)",
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "file-manager",
    "self-hosted",
    "docker",
    "web-file-browser",
    "unzip",
    "totp",
    "apple-style"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "otpauth": "^9.3.6",
    "qrcode": "^1.5.4",
    "tar": "^7.4.3",
    "yauzl": "^3.2.0"
  }
}
